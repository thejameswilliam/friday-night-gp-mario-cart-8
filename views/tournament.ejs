<%- include('partials/head', { pageTitle: tournament.name }) %>

<div class="page-head">
  <div>
    <a class="back" href="/">← All tournaments</a>
    <h1><%= tournament.name %></h1>
    <p class="muted"><%= progress.done %> of <%= progress.total %> races scored</p>
  </div>
  <% if (isAdmin) { %>
    <form method="POST" action="/tournaments/<%= tournament.id %>/delete"
          onsubmit="return confirm('Delete this tournament and all its scores?')">
      <button class="btn btn-danger">Delete</button>
    </form>
  <% } %>
</div>

<!-- Quick search -->
<div class="track-search-wrap">
  <input type="search" id="track-search" class="track-search"
         placeholder="Search by track or cup name…" autocomplete="off" aria-label="Search tracks or cups" />
</div>
<p id="search-empty" class="muted search-empty" hidden>No tracks or cups match your search.</p>

<!-- Standings -->
<section class="standings">
  <% standings.forEach((p, i) => { %>
    <div class="standing <%= i === 0 && p.total > 0 ? 'leader' : '' %>">
      <div class="standing-rank"><%= i === 0 && p.total > 0 ? '👑' : (i + 1) %></div>
      <div class="standing-name"><%= p.name %></div>
      <div class="standing-total"><%= p.total %><span>pts</span></div>
    </div>
  <% }) %>
</section>

<!-- Track grid by cup -->
<% cups.forEach((cup) => { %>
  <section class="cup" data-cup="<%= cup.cup.toLowerCase() %>">
    <h2 class="cup-title">
      <%= cup.cup %>
      <span class="cup-set cup-set-<%= cup.set.toLowerCase() %>"><%= cup.set === 'DLC' ? 'Booster Pass' : 'Base' %></span>
    </h2>
    <div class="track-grid">
      <% cup.tracks.forEach((track) => { %>
        <% const c = slugColor(track.slug); %>
        <div class="track-tile" id="<%= track.slug %>" data-search="<%= (track.name + ' ' + track.slug).toLowerCase() %>">
          <div class="track-thumb" style="background: linear-gradient(135deg, <%= c.from %>, <%= c.to %>);">
            <img src="/tracks/<%= track.slug %>.jpg" alt="" loading="lazy"
                 onerror="this.style.display='none'" />
            <span class="track-thumb-label"><%= track.name %></span>
          </div>
          <div class="track-name"><%= track.name %></div>
          <div class="variant-row">
            <% variants.forEach((v) => { %>
              <% const done = scored.has(track.slug + '|' + v); %>
              <a class="variant-btn <%= done ? 'variant-done' : '' %>"
                 href="/tournaments/<%= tournament.id %>/track/<%= track.slug %>/<%= v %>">
                <%= v === 'normal' ? 'Normal' : 'Mirror' %>
                <% if (done) { %><span class="check">✓</span><% } %>
              </a>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
<% }) %>

<script>
  (function () {
    var input = document.getElementById('track-search');
    if (!input) return;
    var cups = Array.prototype.slice.call(document.querySelectorAll('.cup'));
    var empty = document.getElementById('search-empty');

    function apply() {
      var q = input.value.trim().toLowerCase();
      var anyVisible = false;
      cups.forEach(function (cup) {
        var cupMatch = q !== '' && (cup.getAttribute('data-cup') || '').indexOf(q) !== -1;
        var cupHasVisible = false;
        var tiles = cup.querySelectorAll('.track-tile');
        Array.prototype.forEach.call(tiles, function (tile) {
          var hay = tile.getAttribute('data-search') || '';
          var show = q === '' || cupMatch || hay.indexOf(q) !== -1;
          tile.hidden = !show;
          if (show) cupHasVisible = true;
        });
        cup.hidden = !cupHasVisible;
        if (cupHasVisible) anyVisible = true;
      });
      if (empty) empty.hidden = anyVisible;
    }

    input.addEventListener('input', apply);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { input.value = ''; apply(); }
    });
  })();
</script>

<%- include('partials/foot') %>
