# Copy to .env and fill in. Never commit .env.
PORT=3000

# Shared password required to create tournaments and edit scores.
ADMIN_PASSWORD=change-this-to-something-strong

# Secret used to sign session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-long-random-string

# Set to true in production when the app runs behind Nginx over HTTPS.
# Enables "trust proxy" and marks the session cookie Secure. Leave false for
# plain local HTTP, or logins will silently fail.
BEHIND_PROXY=false

# Optional: override the SQLite file location (defaults to ./data/tournament.db)
# DB_PATH=/var/data/tournament.db
